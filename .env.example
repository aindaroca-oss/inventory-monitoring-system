# Copy to .env for local development. Never commit .env or real credentials.
APP_ENV=development
SECRET_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inventory_system
DB_USER=
DB_PASS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_STARTTLS=1
MAIL_FROM=

# Set this in the frontend build configuration after the cloud API is deployed.
# This is a public URL, never a credential.
API_BASE_URL=
